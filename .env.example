# ========================================================
# DigiStudentWay - Environment Configuration Example
# Shinchan Online Hackathon 2026
# NOTE: Server API keys must NEVER be exposed in client bundles.
# ========================================================

# Gemini API Key (Required for live AI gap detection via /api/analyze)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Tavily Search API Key (Used for "Suggest Sources" grounding if set)
# If omitted, Gemini native Google Search grounding or sample sources are used.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Firebase Web App Configuration (Used for cloud user sync)
# If omitted or left as dummy, DigiStudentWay runs in high-reliability local offline mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
